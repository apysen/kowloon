[internationalization]

locale/translation_remaps={
"res://assets/textures/props/carton_new_flat.png": PackedStringArray("res://assets/textures/props/carton_new_flat_zh.png:zh_HK")
}
locale/translations=PackedStringArray("res://data/i18n/strings.en.translation", "res://data/i18n/strings.zh_HK.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
limits/global_shader_variables/buffer_size=1048576
environment/defaults/default_clear_color=Color(0.07, 0.066, 0.063, 1)
